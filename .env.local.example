# =============================================================================
# Lapanganku — environment pengembangan lokal (DEV)
#
# Salin menjadi `.env.local` lalu sesuaikan bila perlu:
#   cp .env.local.example .env.local
#
# File `.env.local` TIDAK di-commit (lihat .gitignore).
# Untuk produksi, gunakan `.env` di root (lihat .env.production.example).
# =============================================================================

# Database dev (dijalankan via `docker compose -f compose.dev.yaml up -d`).
DATABASE_URL=postgres://lapanganku:lapanganku@localhost:5432/lapanganku?sslmode=disable
ROOT_DOMAIN=lvh.me

# Fitur eksternal opsional saat dev. Biarkan kosong bila tidak dipakai —
# aplikasi tetap jalan (fitur terkait otomatis nonaktif).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://lvh.me:5173/auth/google/callback
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
