{
	# Email untuk Let's Encrypt (custom domain customer).
	email {$ACME_EMAIL}

	# On-demand TLS: sertifikat custom domain diterbitkan saat request pertama
	# masuk. WAJIB pakai "ask" agar Caddy hanya menerbitkan sertifikat untuk
	# domain yang terdaftar (mencegah abuse).
	on_demand_tls {
		ask http://backend:8080/api/internal/tls/allow/{$SAAS_ASK_TOKEN}
	}

	# Storage sertifikat. Persisted lewat volume di compose.
	storage file_system /data/caddy
}

# ---------------------------------------------------------------------------
# Platform zone: lapanganku.id dan subdomain *.lapanganku.id
#
# Cloudflare (proxy) yang terminate SSL untuk browser. Origin Caddy memakai
# Cloudflare Origin Certificate agar Cloudflare bisa verifikasi (Full strict).
# ---------------------------------------------------------------------------
{$ROOT_DOMAIN}, *{$ROOT_DOMAIN} {
	tls /certs/origin.crt /certs/origin.key

	encode zstd gzip

	reverse_proxy frontend:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# ---------------------------------------------------------------------------
# Custom domain customer (lapangan-a.com, dst).
#
# Domain ini TIDAK di proxy Cloudflare (bukan zone kita), jadi Caddy yang
# menerbitkan sertifikat Let's Encrypt sendiri via on-demand TLS.
#
# Blok ini menangkap semua hostname lain. Caddy akan memanggil ask endpoint
# sebelum menerbitkan sertifikat.
# ---------------------------------------------------------------------------
:443 {
	tls {
		on_demand
	}

	encode zstd gzip

	reverse_proxy frontend:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Redirect HTTP -> HTTPS untuk semua hostname.
:80 {
	redir https://{host}{uri} permanent
}
