# =============================================================================
# Lapanganku — contoh konfigurasi produksi (Docker Compose)
#
# Salin file ini menjadi `.env` di root repo, lalu isi nilainya:
#   cp .env.production.example .env
#
# JANGAN mengisi nilai asli langsung di file ini — file ini ikut ter-commit.
# Nilai asli hanya boleh ada di `.env` (yang sudah masuk .gitignore).
# =============================================================================

# --- Database ---
POSTGRES_DB=lapanganku
POSTGRES_USER=lapanganku
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Perhatikan host `postgres` (nama service), bukan localhost.
DATABASE_URL=postgres://lapanganku:ganti-dengan-password-kuat@postgres:5432/lapanganku?sslmode=disable

# --- Domain ---
ROOT_DOMAIN=lapanganku.id
PUBLIC_ROOT_URL=https://lapanganku.id

# URL backend internal untuk frontend (server-side). Default sudah benar
# untuk Docker Compose (nama service), biasanya tidak perlu diubah.
# API_URL=http://backend:8080

# IP publik VPS. Dipakai untuk memverifikasi A record domain customer.
SERVER_PUBLIC_IP=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://lapanganku.id/auth/google/callback

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- TLS / Caddy ---
# Email untuk Let's Encrypt (custom domain customer).
ACME_EMAIL=admin@lapanganku.id
# Token rahasia untuk endpoint "ask" on-demand TLS.
# Buat dengan: openssl rand -hex 32
SAAS_ASK_TOKEN=

# --- Midtrans (pembayaran QRIS) ---
# Ambil dari dashboard Midtrans → Settings → Access Keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "false" untuk sandbox, "true" untuk produksi.
MIDTRANS_IS_PRODUCTION=false
